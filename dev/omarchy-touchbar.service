[Unit]
Description=Omarchy Touch Bar daemon (native, replaces tiny-dfr)
After=default.target

[Service]
ExecStart=%h/Work/omarchy-touchbar/target/release/omarchy-touchbar
Restart=always
RestartSec=5
# needs DRM device (user must be in video group); Touch Bar input comes from
# udev/99-barmarchy-touchbar.rules (video group), input group is a fallback

[Install]
WantedBy=default.target
